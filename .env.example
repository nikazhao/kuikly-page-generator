# ============================================================
# Graph Engineering + Kuikly 项目 — 环境配置
# ============================================================
# --- 方案 1（推荐·腾讯内部）：CodeBuddy API ---
# 从 https://copilot.tencent.com/profile/keys 获取 ck_ 开头的 API Key
# 端点 /v2 仅支持流式请求，项目代码已自动处理
CODEBUDDY_API_KEY=ck_your_key_here
CODEBUDDY_BASE_URL=https://copilot.tencent.com/v2
MODEL=deepseek-v3

# --- 方案 2：硅基流动 SiliconFlow（外部，免费注册）---
# 注册 https://cloud.siliconflow.cn → 左侧「API 密钥」→ 新建密钥
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# MODEL=deepseek-ai/DeepSeek-V3

# --- 方案 3：DeepSeek 官方 ---
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat

# --- 方案 4：OpenAI 官方 ---
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini
